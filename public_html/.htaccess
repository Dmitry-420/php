# ---------- КОДИРОВКА ----------
AddDefaultCharset UTF-8

# ---------- GZIP СЖАТИЕ ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- КЭШ БРАУЗЕРА ----------
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML — без кэша (всегда свежий)
    ExpiresByType text/html "access plus 0 seconds"
    
    # JSON — час
    ExpiresByType application/json "access plus 1 hour"
    
    # CSS и JS — 7 дней
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType application/x-javascript "access plus 7 days"
    
    # Картинки — 1 месяц
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    
    # Шрифты — 1 год
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# ---------- CACHE-CONTROL (для современных браузеров) ----------
<IfModule mod_headers.c>
    # HTML — не кэшировать
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    
    # JSON — час
    <FilesMatch "\.(json)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    
    # CSS и JS — 7 дней
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    
    # Картинки — месяц
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Безопасность
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------- MIME-ТИПЫ ----------
<IfModule mod_mime.c>
    AddType application/json .json
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
</IfModule>

# ---------- ОШИБКИ ----------
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# ---------- БЕЗОПАСНОСТЬ ----------
<IfModule mod_headers.c>
    # HSTS — форсируем HTTPS на год
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    
    # COOP — изоляция окон
    Header always set Cross-Origin-Opener-Policy "same-origin"
    
    # COEP — ОТКЛЮЧЁН, иначе Яндекс.Карты не грузятся
    # Header always set Cross-Origin-Embedder-Policy "require-corp"
    
    # CORP — разрешаем кросс-доменные ресурсы (для тайлов карты)
    Header always set Cross-Origin-Resource-Policy "cross-origin"
    
    # CSP — разрешаем Яндекс.Карты и виджет
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://api-maps.yandex.ru https://yandex.ru https://*.yandex.net https://*.yandex.ru 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://api-maps.yandex.ru https://yandex.ru; img-src 'self' data: blob: https://*.yandex.net https://*.yandex.ru https://*.maps.yandex.net; font-src 'self' data: https://*.yandex.net; connect-src 'self' https://api-maps.yandex.ru https://*.yandex.net https://*.yandex.ru; worker-src 'self' blob:; child-src 'self' blob: https://yandex.ru https://*.yandex.ru; frame-src 'self' https://yandex.ru https://*.yandex.ru https://*.yandex.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>